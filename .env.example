# StudyForge — complete environment contract for M0–M11
# Generated from packages/config/src/catalog.ts; never put real credentials here.
# Owner fills .env.keys once; pnpm env:prepare preserves existing values, then pnpm env:merge-keys.
# See docs/setup/ENV_SETUP.md. Blank agent values are filled during M0. Runtime validation never permits pending values.

# ---------- App ----------
# [REQUIRED] [public] [M0] [local + production] — Single product name
# Source: Repository configuration
APP_NAME=StudyForge
# [REQUIRED] [public] [M0] [local + production] — Runtime environment
# Source: Agent: local=development; production=production
APP_ENV=development
# [REQUIRED] [public] [M0] [local + production] — Web origin
# Source: Agent: local http://localhost:3000; production http://localhost:3001
APP_URL=http://localhost:3000
# [REQUIRED] [public] [M1] [local + production] — CSRF/CORS allowlist
# Source: Agent: normally APP_URL only
ALLOWED_ORIGINS=http://localhost:3000
# [REQUIRED] [public] [M0] [local + production] — Structured logger threshold
# Source: Repository configuration
LOG_LEVEL=info
# [REQUIRED] [public] [M3] [local + production] — Zero-charge billing implementation
# Source: Locked decision: doc07
BILLING_PROVIDER=mock
# [REQUIRED] [public] [M1] [local + production] — Database email delivery
# Source: Locked decision: ADR-0015
EMAIL_PROVIDER=outbox
# [REQUIRED] [public] [M1] [local + production] — Rendered sender placeholder; not an actual mailbox
# Source: Company config placeholder; update centrally with business identity
EMAIL_FROM='StudyForge <no-reply@studyforge.invalid>'
# [REQUIRED] [public] [M1] [local + production] — BotCheck no-op until public hosting
# Source: Locked decision: doc09
BOT_CHECK_PROVIDER=none
# [REQUIRED] [public] [M5] [local + production] — Enable public HTTPS calendar webhook; false uses five-minute polling
# Source: Repository configuration; true only after public hosting
CALENDAR_PUSH_ENABLED=false

# ---------- Supabase ----------
# [REQUIRED] [public] [M0] [local + production] — Supabase API origin
# Source: Supabase project > Settings > API > Project URL; local via agent CLI sync
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# [REQUIRED] [public] [M0] [local + production] — Public Supabase client key
# Source: Supabase project > Settings > API Keys > publishable or legacy anon; local via CLI sync
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [REQUIRED] [secret] [M0] [local + production] — Restricted administrative client credential
# Source: Supabase project > Settings > API Keys > secret or legacy service_role; local via CLI sync
SUPABASE_SERVICE_ROLE_KEY=
# [REQUIRED] [public] [M0] [production] — Cloud project reference
# Source: Supabase project > Settings > General > Reference ID
SUPABASE_PROJECT_REF=
# [REQUIRED] [secret] [M0] [production] — Management API / deploy authentication
# Source: Supabase account avatar > Account > Access Tokens
SUPABASE_ACCESS_TOKEN=
# [REQUIRED] [secret] [M0] [production] — Cloud database operator password
# Source: Password saved at project creation; project > Settings > Database to reset
SUPABASE_DB_PASSWORD=
# [REQUIRED] [secret] [M0] [local + production] — Least-privilege engine DB connection
# Source: Agent: scripted role migration + secret generation; production sslmode=verify-full
ENGINE_DATABASE_URL=

# ---------- Cloud Run ----------
# [REQUIRED] [public] [M0] [local + production] — Signed engine endpoint
# Source: Agent: Terraform output; local http://localhost:8080
ENGINE_URL=http://localhost:8080

# ---------- Security ----------
# [REQUIRED] [secret] [M0] [local + production] — HMAC key for signed web-to-engine RPC
# Source: Agent: openssl rand -base64 48 (or crypto.randomBytes(48).toString("base64"))
ENGINE_RPC_SECRET=
# [REQUIRED] [secret] [M0] [local + production] — HMAC key for DB wake; also provisioned into Vault
# Source: Agent: openssl rand -base64 48 (or crypto.randomBytes(48).toString("base64"))
ENGINE_WAKE_SECRET=

# ---------- Cloud Run ----------
# [REQUIRED] [public] [M0] [local + production] — Local queue poller only
# Source: Agent: local=1; production=0
ENGINE_POLL_MODE=1
# [REQUIRED] [public] [M0] [local + production] — Sandbox foundation endpoint (code runner used in M7)
# Source: Agent: Terraform output; local http://localhost:2000
SANDBOX_URL=http://localhost:2000
# [REQUIRED] [public] [M0] [production] — One cloud project identifier
# Source: Google Cloud Console > project picker > Project ID
GCP_PROJECT_ID=
# [REQUIRED] [public] [M0] [production] — Cloud resource region
# Source: Agent: align with Supabase region
GCP_REGION=us-east1
# [REQUIRED] [public] [M0] [production] — Artifact Registry repository name
# Source: Agent: Terraform
GCP_ARTIFACT_REPO=studyforge
# [REQUIRED] [public] [M0] [production] — Impersonated deployer identity; never a key file
# Source: Agent: Terraform sf-deployer service account output
GCP_DEPLOY_SERVICE_ACCOUNT=
# [REQUIRED] [public] [M0] [production] — Locked/versioned Terraform state bucket
# Source: Agent: scripted GCS bootstrap
TF_STATE_BUCKET=

# ---------- Security ----------
# [REQUIRED] [secret] [M1] [local + production] — CSRF signing secret
# Source: Agent: openssl rand -base64 48 (or crypto.randomBytes(48).toString("base64"))
CSRF_SECRET=
# [REQUIRED] [secret] [M3] [local + production] — Mock billing event signature
# Source: Agent: openssl rand -base64 48 (or crypto.randomBytes(48).toString("base64"))
MOCK_BILLING_WEBHOOK_SECRET=
# [REQUIRED] [secret] [M5] [local + production] — Signed OAuth state and channel tokens
# Source: Agent: openssl rand -base64 48 (or crypto.randomBytes(48).toString("base64"))
OAUTH_STATE_SECRET=

# ---------- AI ----------
# [REQUIRED] [secret] [M4] [local + production] — LLM adapter credential
# Source: Anthropic Console > Settings > API Keys; set Limits > monthly spend cap
ANTHROPIC_API_KEY=
# [REQUIRED] [public] [M4] [local + production] — Initial global monthly AI budget
# Source: Repository default; seed into admin provider config
GLOBAL_AI_BUDGET_USD=100
# [REQUIRED] [secret] [M4] [local + production] — Langfuse Basic auth public component (server-only)
# Source: US Langfuse project > Settings > API Keys
LANGFUSE_PUBLIC_KEY=
# [REQUIRED] [secret] [M4] [local + production] — Langfuse Basic auth secret component
# Source: US Langfuse project > Settings > API Keys
LANGFUSE_SECRET_KEY=
# [REQUIRED] [public] [M4] [local + production] — Langfuse cloud API origin
# Source: Project region from Langfuse dashboard
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ---------- Optional paid adapters ----------
# [OPTIONAL] [secret] [M4] [local + production] — Optional STT
# Source: console.deepgram.com > API Keys
DEEPGRAM_API_KEY=
# [OPTIONAL] [secret] [M4] [local + production] — Optional STT/diarization
# Source: assemblyai.com > Dashboard > API Keys
ASSEMBLYAI_API_KEY=
# [OPTIONAL] [secret] [M4] [local + production] — Optional document OCR
# Source: console.mistral.ai > API Keys
MISTRAL_API_KEY=
# [OPTIONAL] [secret] [M4] [local + production] — Optional embeddings
# Source: dash.voyageai.com > API Keys
VOYAGE_API_KEY=
# [OPTIONAL] [secret] [M4] [local + production] — Optional transcription/embeddings
# Source: platform.openai.com > API Keys
OPENAI_API_KEY=

# ---------- Web push ----------
# [REQUIRED] [public] [M2] [local + production] — Web push public P-256 key
# Source: Agent: pnpm env:prepare (crypto.createECDH("prime256v1")); equivalent: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# [REQUIRED] [secret] [M2] [local + production] — Web push private P-256 key
# Source: Agent: pnpm env:prepare; generated together with public key, never rotate one alone
VAPID_PRIVATE_KEY=
# [REQUIRED] [public] [M2] [local + production] — Web push contact placeholder
# Source: Business contact in company config before go-live
VAPID_SUBJECT=mailto:admin@studyforge.invalid

# ---------- Google OAuth ----------
# [REQUIRED] [public] [M1] [local + production] — One OAuth client for login/calendar
# Source: Google Cloud > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_OAUTH_CLIENT_ID=
# [REQUIRED] [secret] [M1] [local + production] — OAuth client authentication
# Source: Same OAuth client details > Client secret
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Observability ----------
# [REQUIRED] [public] [M0] [local + production] — One Sentry project for web/engine
# Source: sentry.io > project > Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# [OPTIONAL] [secret] [M0] [local + production] — Optional sourcemap upload auth
# Source: sentry.io > Settings > Auth Tokens
SENTRY_AUTH_TOKEN=
# [OPTIONAL] [public] [M0] [local + production] — Sourcemap organization slug when token supplied
# Source: sentry.io > Settings > Organization > slug
SENTRY_ORG=
# [OPTIONAL] [public] [M0] [local + production] — Sourcemap project slug when token supplied
# Source: sentry.io > project > Settings > General > slug
SENTRY_PROJECT=studyforge
# [REQUIRED] [public] [M2] [local + production] — Consent-gated project ingestion key
# Source: PostHog > Project Settings > Project API key; Session Replay OFF
NEXT_PUBLIC_POSTHOG_KEY=
# [REQUIRED] [public] [M2] [local + production] — Public ingestion origin; private API origin derived
# Source: PostHog project region
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# [REQUIRED] [secret] [M10] [local + production] — Read project metadata and delete user analytics
# Source: PostHog avatar > Account settings > Personal API Keys; project read + required rights scopes
POSTHOG_PERSONAL_API_KEY=
# [REQUIRED] [public] [M2] [local + production] — Analytics project ID
# Source: PostHog > Project Settings > Project ID
POSTHOG_PROJECT_ID=
# [REQUIRED] [secret] [M2] [production] — Uptime monitors/status-page administration
# Source: betterstack.com > Uptime > Settings > API tokens
BETTERSTACK_API_TOKEN=

# ---------- Future billing ----------
# [OPTIONAL] [secret] [future] [local + production] — Unused until real billing
# Source: Stripe > Developers > API Keys; leave blank
STRIPE_SECRET_KEY=
# [OPTIONAL] [secret] [future] [local + production] — Unused until real billing
# Source: Stripe > Developers > Webhooks > signing secret; leave blank
STRIPE_WEBHOOK_SECRET=
# [OPTIONAL] [public] [future] [local + production] — Unused until real billing
# Source: Stripe > Developers > API Keys; leave blank
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
