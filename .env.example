# =====================================================================
# StudyForge — .env.example  (COMPLETE list for M0–M11)
# ---------------------------------------------------------------------
# HOW TO USE
#   1. cp .env.example .env.local        (local dev with local Supabase in Docker; git-ignored)
#      cp .env.example .env.production   (web tier against the one cloud environment; git-ignored)
#   2. Fill every REQUIRED value. OPTIONAL = paid adapters; the app runs without them.
#   3. scripts/env/push-secrets.sh production   → copies what Cloud Run needs into Google Secret Manager
#   4. pnpm env:check                    (validates format + live read-only connectivity; never prints values)
#
# Legend per variable:  [REQUIRED|OPTIONAL] [secret|public] [first used: M#] [envs] — where to get it
# NEVER commit real values. NEVER prefix a secret with NEXT_PUBLIC_.
# The agent keeps this file authoritative; docs/setup/ENV_SETUP.md has step-by-step instructions.
# =====================================================================

# ---------- App ----------
# [REQUIRED] [public] [M0] [all] — placeholder brand name; rename here only
APP_NAME=StudyForge
# [REQUIRED] [public] [M0] [all] — where the web tier is served: local http://localhost:3000, production http://localhost:3001
APP_URL=http://localhost:3000
# [REQUIRED] [public] [M0] [all] — development | production
APP_ENV=development
# [REQUIRED] [public] [M3] [all] — keep "mock" until real billing (doc 07 §7)
BILLING_PROVIDER=mock
# [REQUIRED] [public] [M1] [all] — "outbox" = store every email in the database, readable in Admin → Mail outbox (ADR-0015)
EMAIL_PROVIDER=outbox
# [REQUIRED] [public] [M1] [all] — display name/address on rendered emails (not a real mailbox)
EMAIL_FROM="StudyForge <no-reply@studyforge.invalid>"
# [REQUIRED] [public] [M1] [all] — comma-separated allowed origins for CSRF/CORS (normally just APP_URL)
ALLOWED_ORIGINS=http://localhost:3000
# [REQUIRED] [public] [M5] [all] — false while the web tier has no public HTTPS URL (calendar syncs by polling every 5 min)
CALENDAR_PUSH_ENABLED=false
# [REQUIRED] [public] [M1] [all] — "none" until a CAPTCHA provider is added (BotCheck interface)
BOT_CHECK_PROVIDER=none

# ---------- Supabase (local via CLI in Docker; ONE cloud project: studyforge) ----------
# [REQUIRED] [public] [M0] [all] — Supabase dashboard → Project Settings → API → Project URL (local: printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# [REQUIRED] [public] [M0] [all] — Project Settings → API Keys → publishable (anon) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [REQUIRED] [secret] [M0] [all; server only] — Project Settings → API Keys → secret (service_role) key
SUPABASE_SERVICE_ROLE_KEY=
# [REQUIRED] [public] [M0] [production] — Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=
# [REQUIRED] [secret] [M0] [production] — supabase.com → Account → Access Tokens (used by the deploy scripts to push migrations)
SUPABASE_ACCESS_TOKEN=
# [REQUIRED] [secret] [M0] [production] — database password set at project creation (Project Settings → Database)
SUPABASE_DB_PASSWORD=
# [REQUIRED] [secret] [M0] [all] — engine_worker role connection string (the agent creates the role and a random password in M0 and writes this value itself)
#   format: postgresql://engine_worker:<pw>@<host>:5432/postgres?sslmode=verify-full
ENGINE_DATABASE_URL=

# ---------- Engine & sandbox (Google Cloud Run) ----------
# [REQUIRED] [public] [M0] [all] — local: http://localhost:8080 ; deployed: the sf-engine Cloud Run URL (printed by Terraform)
ENGINE_URL=http://localhost:8080
# [REQUIRED] [secret] [M0] [all] — signs web → engine /rpc calls. generate: openssl rand -base64 48
ENGINE_RPC_SECRET=
# [REQUIRED] [secret] [M0] [all] — signs database → engine /wake calls (also stored in Supabase Vault for pg_net). generate: openssl rand -base64 48
ENGINE_WAKE_SECRET=
# [OPTIONAL] [public] [M0] [local only] — 1 = engine polls the queue itself (no pg_net → localhost needed in dev)
ENGINE_POLL_MODE=1
# [REQUIRED] [public] [M7] [all] — local: http://localhost:2000 ; deployed: the sf-sandbox Cloud Run URL (IAM-protected; only the engine can call it)
SANDBOX_URL=http://localhost:2000
# [REQUIRED] [public] [M0] [production] — console.cloud.google.com → project picker → Project ID of your one `studyforge` project
GCP_PROJECT_ID=
# [REQUIRED] [public] [M0] [production] — one region close to your Supabase region, e.g. us-east1
GCP_REGION=us-east1
# [REQUIRED] [public] [M0] [production] — Artifact Registry Docker repo name (created by Terraform)
GCP_ARTIFACT_REPO=studyforge
# [REQUIRED] [public] [M0] [production] — output of Terraform: deployer service account your gcloud login impersonates (no key files)
GCP_DEPLOY_SERVICE_ACCOUNT=
# [REQUIRED] [public] [M0] [production] — GCS bucket for Terraform state (versioned). Create once: gcloud storage buckets create gs://<name> --uniform-bucket-level-access
TF_STATE_BUCKET=

# ---------- Security ----------
# [REQUIRED] [secret] [M1] [all] — generate: openssl rand -base64 48
CSRF_SECRET=
# [REQUIRED] [secret] [M3] [all] — generate: openssl rand -base64 48
MOCK_BILLING_WEBHOOK_SECRET=
# [REQUIRED] [secret] [M5] [all] — generate: openssl rand -base64 48 (signs OAuth state + calendar channel tokens)
OAUTH_STATE_SECRET=

# ---------- AI ----------
# [REQUIRED] [secret] [M4] [all; server + engine] — console.anthropic.com → API Keys (one key, used locally and in production; set a monthly spend limit!)
ANTHROPIC_API_KEY=
# [REQUIRED] [public] [M4] [all] — global monthly AI budget in USD (doc 06 §6)
GLOBAL_AI_BUDGET_USD=100
# [REQUIRED] [secret] [M4] [all] — cloud.langfuse.com → project → Settings → API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
# [OPTIONAL] [secret] [M4] [production] — paid adapters; leave blank to use free self-hosted adapters
DEEPGRAM_API_KEY=          # console.deepgram.com → API Keys (speech-to-text)
ASSEMBLYAI_API_KEY=        # assemblyai.com → Dashboard → API key (speech-to-text + diarization)
MISTRAL_API_KEY=           # console.mistral.ai → API Keys (OCR)
VOYAGE_API_KEY=            # dash.voyageai.com → API Keys (embeddings)
OPENAI_API_KEY=            # platform.openai.com → API keys (transcription/embeddings option)

# ---------- Web push (PWA) ----------
# [REQUIRED] [public/secret] [M2] [all] — generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@studyforge.invalid

# ---------- Google OAuth (ONE client for both Google sign-in and Calendar) ----------
# [REQUIRED] [secret] [M1] [all] — Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
#   Used for Google sign-in (the agent configures it into Supabase Auth + supabase/config.toml) AND for Calendar (M5).
#   Redirect URIs: http://127.0.0.1:54321/auth/v1/callback, https://<project-ref>.supabase.co/auth/v1/callback,
#   http://localhost:3000/api/v1/calendar/oauth/google/callback, http://localhost:3001/api/v1/calendar/oauth/google/callback
#   Consent screen stays in Testing mode (add yourself as a test user); enable the Google Calendar API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Observability & analytics ----------
# [REQUIRED] [public] [M0] [all] — sentry.io → your ONE project "studyforge" → Settings → Client Keys (DSN). Used by both web and engine (tagged service=web|engine)
NEXT_PUBLIC_SENTRY_DSN=
# [OPTIONAL] [secret] [M0] [all] — sentry.io → Settings → Auth Tokens; only for readable stack traces (sourcemap upload). Blank = skip upload
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
# [REQUIRED] [public] [M2] [all] — posthog.com → Project Settings → Project API key (session replay OFF)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# [REQUIRED] [secret] [M10] [production] — PostHog → Personal API keys (needed to delete persons on account deletion)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# [REQUIRED] [secret] [M2] [production] — betterstack.com → API tokens (monitors + status page as code)
BETTERSTACK_API_TOKEN=

# ---------- Real billing (NOT used yet — leave blank until doc 07 §7) ----------
# [OPTIONAL] [secret] [future] — Stripe dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
