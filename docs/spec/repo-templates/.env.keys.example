# =====================================================================
#  StudyForge: THE ONLY FILE YOU FILL IN
#  Paste each value right after the "=" (no quotes, no spaces).
#  This file is git-ignored. Codex copies these into .env.local / .env.production
#  for you (without printing them). Step-by-step clicks: docs/setup/KEYS_CHECKLIST.md
# =====================================================================

# ---------- 1. SUPABASE: supabase.com → your project "studyforge" ----------
# Project Settings → API → Project URL
SUPABASE_URL=
# Project Settings → API Keys → publishable / "anon" key
SUPABASE_ANON_KEY=
# Project Settings → API Keys → secret / "service_role" key
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=
# The database password you chose when creating the project
SUPABASE_DB_PASSWORD=
# Avatar (top right) → Account → Access Tokens → Generate new token
SUPABASE_ACCESS_TOKEN=

# ---------- 2. GOOGLE CLOUD: console.cloud.google.com → project "studyforge" ----------
# Project picker → the ID column (not the name)
GCP_PROJECT_ID=

# ---------- 3. GOOGLE OAUTH: same project → APIs & Services → Credentials → your OAuth client ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- 4. ANTHROPIC: console.anthropic.com → API Keys ----------
ANTHROPIC_API_KEY=

# ---------- 5. SENTRY: sentry.io → project "studyforge" → Settings → Client Keys (DSN) ----------
SENTRY_DSN=

# ---------- 6. POSTHOG: posthog.com → project "studyforge" ----------
# Project Settings → Project API key
POSTHOG_PROJECT_API_KEY=
# Project Settings → Project ID (a number)
POSTHOG_PROJECT_ID=
# Avatar → Account settings → Personal API keys → Create
POSTHOG_PERSONAL_API_KEY=

# ---------- 7. LANGFUSE: cloud.langfuse.com (US) → project "studyforge" → Settings → API Keys ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 8. BETTER STACK: betterstack.com → Uptime → Settings → API tokens ----------
BETTERSTACK_API_TOKEN=

# ---------- OPTIONAL: leave blank (paid services, only for Pro/Pro+ users) ----------
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
MISTRAL_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
